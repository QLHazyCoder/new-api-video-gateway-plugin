      "path": ["openai_video", "decodeRequest"],
      "args": [{"body":{"kind":"json","value":{"model":"doubao-seedance-2-5-260628","prompt":"A slow camera move","duration":30,"resolution":"720p"}},"model":"doubao-seedance-2-5-260628","upstreamModel":"doubao-seedance-2-5-260628"}],
