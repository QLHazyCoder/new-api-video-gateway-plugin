    {
      "name": "rejects non-HTTPS resource IDs",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [{"body":{"kind":"json","value":{"model":"doubao-seedance-2-0-260128","prompt":"Animate the still","duration":6,"resolution":"720p","input_reference":"service-asset-123"}},"model":"doubao-seedance-2-0-260128","upstreamModel":"doubao-seedance-2-0-260128"}],
      "expectedError": "must be a public HTTPS URL"
