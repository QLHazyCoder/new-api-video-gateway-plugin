    },
    {
      "name": "accepts structured content JSON for the extended model",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [{
        "body": {"kind":"json","value":{
          "model":"doubao-seedance-2-5-260628",
          "content":[
            {"type":"text","text":"Continue the scene"},
            {"type":"image_url","image_url":{"url":"https://media.example/still.png"},"role":"reference_image"},
            {"type":"video_url","video_url":{"url":"https://media.example/reference.mp4"},"role":"reference_video"},
            {"type":"audio_url","audio_url":{"url":"https://media.example/audio.mp3"},"role":"reference_audio"}
          ],
          "duration":6,"resolution":"720p","ratio":"9:16","generate_audio":true,"watermark":false,"seed":42
        }},
        "model":"doubao-seedance-2-5-260628","upstreamModel":"doubao-seedance-2-5-260628"
      }],
      "expected": {"kind":"submit","model":"doubao-seedance-2-5-260628","action":"reference_to_video","requestBody":{
        "model":"doubao-seedance-2-5-260628",
        "content":[
          {"type":"text","text":"Continue the scene"},
          {"type":"image_url","image_url":{"url":"https://media.example/still.png"},"role":"reference_image"},
          {"type":"video_url","video_url":{"url":"https://media.example/reference.mp4"},"role":"reference_video"},
          {"type":"audio_url","audio_url":{"url":"https://media.example/audio.mp3"},"role":"reference_audio"}
        ],
        "resolution":"720p","ratio":"9:16","duration":6,"generate_audio":true,"watermark":false,"seed":42
      }}
    },
    {
      "name": "forwards structured content JSON to the gateway",
      "hook": "buildSubmitRequest",
      "args": [{
        "requestBody": {
          "model":"doubao-seedance-2-0-fast-260128",
          "content":[
            {"type":"text","text":"Continue the clip"},
            {"type":"video_url","video_url":{"url":"https://media.example/reference.mp4"},"role":"reference_video"}
          ],
          "duration":6,"resolution":"720p","ratio":"16:9"
        },
        "model":"doubao-seedance-2-0-fast-260128","upstreamModel":"doubao-seedance-2-0-fast-260128",
        "baseUrl":"https://coderapi.vip","apiKey":"test-key"
      }],
      "expected": {
        "url":"https://coderapi.vip/v1/videos","method":"POST",
