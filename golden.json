      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [{"body":{"kind":"json","value":{"model":"doubao-seedance-2-0-260128","prompt":"A slow camera move","duration":6,"resolution":"1080p"}},"model":"doubao-seedance-2-0-260128","upstreamModel":"doubao-seedance-2-0-260128"}],
