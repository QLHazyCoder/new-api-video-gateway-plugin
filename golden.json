    {
      "name": "rejects Extended local multipart images",
      "hook": "protocols",
      "path": ["openai_video", "decodeRequest"],
      "args": [{"body":{"kind":"multipart","fields":{"model":["doubao-seedance-2-0-260128"],"prompt":["Animate the upload"],"duration":["6"],"resolution":["720p"]},"files":[{"ref":"request_file:image","field":"image","filename":"still.png","mimeType":"image/png","size":1024}]},"model":"doubao-seedance-2-0-260128","upstreamModel":"doubao-seedance-2-0-260128"}],
      "expectedError": "requires a public HTTPS image URL"
